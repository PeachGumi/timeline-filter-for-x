{
  "manifest_version": 3,
  "name": "Hide Verified Users on X (Fixed)",
  "version": "2.4.3",
  "description": "X / Twitterで、有料の青バッジ投稿を非表示にし、AI生成ラベル付き投稿や日本語以外の投稿もオプションで非表示にします。",
  "icons": {
    "48": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
